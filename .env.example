# ═══════════════════════════════════════════════════════════════════════════
# QVARRY API - TEMPLATE DE CONFIGURATION (PRODUCTION)
# ═══════════════════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et adaptez les valeurs selon votre environnement
#
# Pour générer des secrets sécurisés :
#   - Clé hex 64 chars : openssl rand -hex 32
#   - Secret base64    : openssl rand -base64 64
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 ENVIRONNEMENT GÉNÉRAL
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# URL du client frontend (CORS, liens emails)
CLIENT_URL=https://app.qvarry.fr
FRONTEND_URL=https://app.qvarry.fr

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 SECRETS ET CLÉS DE CHIFFREMENT
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ IMPORTANT: NE JAMAIS utiliser les valeurs d'exemple en production!
# Générez des valeurs uniques et sécurisées avec les commandes fournies.
# ─────────────────────────────────────────────────────────────────────────────

# Secret JWT pour la signature des tokens d'authentification (access token)
# ⚠️ Minimum 64 bytes (512 bits) recommandé
# Générer avec: openssl rand -base64 64
JWT_SECRET=GENERATE_WITH__openssl_rand_base64_64__DO_NOT_USE_THIS_VALUE

# Secret JWT pour la signature des refresh tokens (doit être DIFFÉRENT de JWT_SECRET)
# Générer avec: openssl rand -base64 64
JWT_REFRESH_SECRET=GENERATE_WITH__openssl_rand_base64_64__DO_NOT_USE_THIS_VALUE

# Clé de chiffrement des données sensibles utilisateurs (fiches, points, etc.)
# ⚠️ Doit faire EXACTEMENT 32 bytes (64 caractères hexadécimaux) pour AES-256
# Générer avec: openssl rand -hex 32
ENCRYPTION_KEY_MASTER=GENERATE_WITH__openssl_rand_hex_32__64_CHARS_HEX_REQUIRED
# Clé de chiffrement pour les communications (messages, conversations)
# ⚠️ Doit faire EXACTEMENT 32 bytes (64 caractères hexadécimaux) pour AES-256
# Générer avec: openssl rand -hex 32
ENCRYPTION_KEY_COMMUNICATION=GENERATE_WITH__openssl_rand_hex_32__64_CHARS_HEX_REQUIRED

# Secret pour le hash des adresses IP dans les logs d'audit (anonymisation RGPD)
# Générer avec: openssl rand -hex 32
IP_HASH_SECRET=GENERATE_WITH__openssl_rand_hex_32__DO_NOT_USE_THIS_VALUE

# Clé HMAC pour le hachage des emails (minimum 32 caractères)
# Générer avec: openssl rand -hex 32
# IMPORTANT: Cette clé protège les emails contre les attaques par rainbow table
EMAIL_HMAC_KEY=GENERATE_WITH__openssl_rand_hex_32__DO_NOT_USE_THIS_VALUE

# ═══════════════════════════════════════════════════════════════════════════
# 💡 AIDE: Utilisez le script automatique pour générer tous les secrets :
#    npm run generate:secrets
#    ou
#    bash scripts/generate-secrets.sh
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🔑 ROTATION DES CLÉS JWT (Optionnel - Avancé)
# ─────────────────────────────────────────────────────────────────────────────
# Permet de faire une rotation des clés JWT sans invalider les anciens tokens.
# En fonctionnement normal, laisser commenté (seul JWT_SECRET est utilisé).
# JWT_SECRET_V2=GENERATE_WITH__openssl_rand_base64_64
# JWT_SECRET_V3=GENERATE_WITH__openssl_rand_base64_64

# ─────────────────────────────────────────────────────────────────────────────
# ⏱️ DURÉES DES TOKENS
# ─────────────────────────────────────────────────────────────────────────────
# JWT Access Token - Durée courte (recommandé: 15m-30m)
JWT_EXPIRES_IN=15m

# Refresh Token - Durée longue (en heures)
REFRESH_TOKEN_EXPIRES_IN=48

# ─────────────────────────────────────────────────────────────────────────────
# 🔒 SÉCURITÉ DES SESSIONS
# ─────────────────────────────────────────────────────────────────────────────
REQUIRE_ACTIVE_SESSION=true
ALLOW_SESSION_RECOVERY=false
VALIDATE_SESSION_METADATA=true
SESSION_TTL=3600
SESSION_TIMEOUT_MS=3600000
SESSION_CLEANUP_INTERVAL_MS=300000
MAX_SESSIONS_PER_USER=5
MAX_TOTAL_SESSIONS=10000

# ─────────────────────────────────────────────────────────────────────────────
# 🍪 COOKIES (Utilisé pour les tokens web)
# ─────────────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# ─────────────────────────────────────────────────────────────────────────────
# 🛡️ RATE LIMITING - Protection contre le brute force
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_BLOCK_MINUTES=30

# Rate limiting pour routes mobiles
MOBILE_RATE_LIMIT_MAX=5
MOBILE_RATE_LIMIT_WINDOW_MINUTES=15
MOBILE_RATE_LIMIT_BLOCK_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────────
# 📦 LIMITES DE PAYLOAD HTTP
# ─────────────────────────────────────────────────────────────────────────────
# Taille max d'un body JSON (express.json). Valeur par défaut : 10mb.
# Les uploads de fichiers (photos, etc.) passent en multipart via multer et
# ne sont PAS impactés par cette limite — ils ont leur propre quota.
JSON_BODY_LIMIT=10mb

# ─────────────────────────────────────────────────────────────────────────────
# 🚨 ALERTES DE SÉCURITÉ AUTOMATIQUES
# ─────────────────────────────────────────────────────────────────────────────
SECURITY_AUTO_BLOCK_THRESHOLD=10
SECURITY_AUTO_BLOCK_HOURS=24
SECURITY_ANALYSIS_WINDOW=15

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ BASE DE DONNÉES MONGODB
# ─────────────────────────────────────────────────────────────────────────────
DB_CONN_STRING=mongodb+srv://user:password@cluster.mongodb.net/?appName=QvarryStorage
DB_NAME=QvarryStorage
DB_SSL=true

# ─────────────────────────────────────────────────────────────────────────────
# 🔴 REDIS - Sessions persistantes et blacklist tokens
# ─────────────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis-server
REDIS_PORT=6379
REDIS_PASSWORD=VOTRE_MOT_DE_PASSE_REDIS
REDIS_DB=0
REDIS_TLS=true # Toujours true en production

# Configuration cluster Redis (optionnel)
USE_REDIS_CLUSTER=false
REDIS_CLUSTER_NODES=

# Redis Pub/Sub pour clustering WebSocket (horizontal scaling)
# Permet à plusieurs instances API de partager les connexions WebSocket
REDIS_PUBSUB_ENABLED=true
REDIS_PUBSUB_RECONNECT_DELAY=1000
REDIS_PUBSUB_MAX_RETRIES=10

# ─────────────────────────────────────────────────────────────────────────────
# 🔄 WEBSOCKET STATE PERSISTENCE & RESILIENCE (PHASE 4)
# ─────────────────────────────────────────────────────────────────────────────
# Persistance des états WebSocket pour reprise de connexion transparente
# après déconnexions, crashes ou redémarrages serveur

# Activer la persistance d'état (nécessite Redis)
WS_STATE_ENABLED=true

# Durée de rétention des états (en heures)
WS_STATE_TTL_HOURS=168

# Intervalle de sauvegarde automatique des états (en ms)
WS_STATE_SAVE_INTERVAL=30000

# Intervalle de vérification des connexions perdues (en ms)
WS_STATE_CLEANUP_INTERVAL=3600000

# Message Delivery - Garantie de livraison au-moins-une-fois
WS_MESSAGE_ACK_TIMEOUT=30000
WS_MESSAGE_RETRY_ATTEMPTS=3
WS_MESSAGE_DELIVERY_TTL=86400

# Heartbeat - Intervalle de ping/pong pour détecter les connexions mortes (ms)
WS_HEARTBEAT_INTERVAL_MS=30000

# Graceful Shutdown - Arrêt progressif du serveur
WS_GRACEFUL_SHUTDOWN_TIMEOUT=10000
WS_SHUTDOWN_MESSAGE=Le serveur redémarre pour maintenance

# Reconnection Monitoring - Surveillance des connexions obsolètes
WS_RECONNECTION_CHECK_INTERVAL=300000
WS_STALE_CONNECTION_THRESHOLD=300000

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 CLOUDFLARE TURNSTILE (CAPTCHA Anti-bot)
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=VOTRE_CLE_SECRETE_TURNSTILE

# Bypass CAPTCHA : DOIT rester false en production (validateEnv.ts rejette le boot si true en prod).
# À utiliser uniquement en dev/CI pour les tests automatisés.
BYPASS_CAPTCHA=false

# ─────────────────────────────────────────────────────────────────────────────
# 📧 CONFIGURATION SMTP (Envoi d'emails)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_SECURE=false # false + port 587 = STARTTLS (chiffré). Mettre true + port 465 pour SSL direct.
SMTP_USER=noreply@qvarry.fr
SMTP_PASS=VOTRE_MOT_DE_PASSE_SMTP
EMAIL_FROM=noreply@qvarry.fr
CONTACT_EMAIL=contact@qvarry.fr

# ─────────────────────────────────────────────────────────────────────────────
# 📱 CONFIGURATION MOBILE
# ─────────────────────────────────────────────────────────────────────────────
MIN_IOS_VERSION=1.0.0
MIN_ANDROID_VERSION=1.0.0
MOBILE_BUNDLE_ID_IOS=fr.qvarry.app
MOBILE_BUNDLE_ID_ANDROID=fr.qvarry.app

# ─────────────────────────────────────────────────────────────────────────────
# 🛡️ ATTESTATION DES APPAREILS (Device Integrity)
# ─────────────────────────────────────────────────────────────────────────────
# Activer la vérification d'intégrité des appareils mobiles (false = mode bypass)
ATTESTATION_ENABLED=false

# iOS App Attest (Apple Developer → votre app → App Attest)
APPLE_APP_ID=TEAM_ID.fr.qvarry.app
APPLE_TEAM_ID=VOTRE_TEAM_ID_APPLE

# Android Play Integrity (Google Play Console → votre app → Setup → App integrity)
GOOGLE_PACKAGE_NAME=fr.qvarry.app
GOOGLE_PROJECT_NUMBER=VOTRE_PROJECT_NUMBER_GOOGLE
# Compte de service Google Play Integrity (base64 du JSON)
# Générer avec: base64 -i google-service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT=BASE64_DU_JSON_GOOGLE_SERVICE_ACCOUNT

# ─────────────────────────────────────────────────────────────────────────────
# 🆘 MODE SOS - Vonage SMS (Alertes d'urgence)
# ─────────────────────────────────────────────────────────────────────────────
# Clé API Vonage (trouvable sur https://dashboard.nexmo.com/settings)
VONAGE_API_KEY=CHANGEZ_MOI
VONAGE_API_SECRET=CHANGEZ_MOI

# MED-003: Secret pour la validation HMAC des webhooks Vonage
# ⚠️ CRITIQUE: Ce secret DOIT être configuré pour sécuriser le système SOS
# 
# ÉTAPES DE CONFIGURATION:
# 1. Générer un secret fort (256 bits) :
#    openssl rand -hex 32
#
# 2. Configurer le secret dans Vonage Dashboard :
#    → https://dashboard.nexmo.com/
#    → Settings → API Settings
#    → Section "Signature Secret for SMS"
#    → Coller le secret généré
#    → Activer "Signature validation required"
#    → Save changes
#
# 3. Copier le MÊME secret ici :
VONAGE_SIGNATURE_SECRET=CHANGEZ_MOI_64_CARACTERES_HEX

# Nom ou numéro d'expéditeur SMS (max 11 caractères alphanumériques pour la France)
VONAGE_SMS_FROM=Qvarry

# ─────────────────────────────────────────────────────────────────────────────
# 📦 CREDENTIALS JSON (Firebase, Google, etc.)
# ─────────────────────────────────────────────────────────────────────────────
# Convention : tous les fichiers JSON de credentials sont encodés en base64
# et stockés comme variables d'environnement.
#
# Encoder un fichier :
#   base64 -i mon-fichier.json | tr -d '\n'
#
# ⚠️ Ne jamais commiter les fichiers JSON originaux (déjà dans .gitignore ✓)
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK (Push Notifications / FCM)
# Télécharger depuis : Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=BASE64_DU_JSON_FIREBASE_SERVICE_ACCOUNT

# Développement local uniquement (chemin vers le fichier JSON)
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Firebase App Check (routes mobiles + WebSocket)
# true  → vérification stricte du token (header X-Firebase-AppCheck / query ?appcheck=...)
# false → bypass complet (utile pour staging avec app non instrumentée, ou prod en rollout)
# Non défini → activé sauf en NODE_ENV=development
#
# ⚠️ ATTENTION : tant que l'app mobile (Qvarry-phone) n'a pas implémenté
# @react-native-firebase/app-check + provider App Attest (iOS) / Play Integrity (Android),
# laisser APP_CHECK_ENABLED=false en production.
# Sinon : toutes les requêtes mobile retournent 401 (header X-Firebase-AppCheck absent).
APP_CHECK_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# 🔍 AUDIT, LOGGING ET MONITORING
# ─────────────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
LOG_AUTH_ACCESS=false
LOG_ADMIN_ACCESS=true
SEND_LOGIN_ALERTS=true

# Niveau de log en production (critical, error, warn, info, http, debug)
LOG_LEVEL=info
# Dossier de stockage des logs (défaut: logs)
LOG_DIR=logs

# Token bearer pour protéger /metrics (scrape Prometheus). Si vide, /metrics renvoie 404.
# Générer avec : openssl rand -hex 32
METRICS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# 🆘 SOS — ALERTES COMMUNAUTAIRES
# ─────────────────────────────────────────────────────────────────────────────
# Rayon (en km) du broadcast SOS Stage 1 autour de la dernière position connue.
# Les users hors rayon ou sans position connue ne reçoivent pas l'alerte.
# Default : 50 km si non défini.
SOS_BROADCAST_RADIUS_KM=50

# ─────────────────────────────────────────────────────────────────────────────
# 📷 STOCKAGE DE PHOTOS
# ─────────────────────────────────────────────────────────────────────────────
# Chemin de stockage des photos de points GPS
# Production Docker/Dokploy : bind mount configuré sur /app/uploads
STORAGE_PATH=/app/uploads/points
# Quota par défaut par utilisateur (en Go)
STORAGE_DEFAULT_QUOTA_GB=2


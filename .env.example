# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURATION DE SÉCURITÉ - AUTHENTIFICATION PROFESSIONNELLE
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 SECRETS ET CLÉS (À GÉNÉRER ALÉATOIREMENT EN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-minimum-256-bits-please-change-me
MASTER_KEY=your-master-encryption-key-for-database-encryption-change-me

# ─────────────────────────────────────────────────────────────────────────────
# ⏱️  DURÉES DES TOKENS (NIVEAU PROFESSIONNEL)
# ─────────────────────────────────────────────────────────────────────────────
# JWT Access Token - Durée courte recommandée
# Note: 30m recommandé pour éviter les problèmes de refresh, minimum 15m pour la sécurité
JWT_EXPIRES_IN=30m                    # 30 minutes (recommandé: 15m-30m)

# Refresh Token - Durée longue
REFRESH_TOKEN_EXPIRES_IN=168          # 168 heures = 7 jours (en heures)

# ─────────────────────────────────────────────────────────────────────────────
# 🛡️  PROTECTION CONTRE LE BRUTE FORCE (RATE LIMITING)
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=10            # Nombre max de tentatives (augmenté pour UX)
RATE_LIMIT_WINDOW_MINUTES=15          # Fenêtre de temps (minutes)
RATE_LIMIT_BLOCK_MINUTES=15           # Durée du blocage (minutes, réduit de 30)

# ─────────────────────────────────────────────────────────────────────────────
# 🔒 SÉCURITÉ DES SESSIONS
# ─────────────────────────────────────────────────────────────────────────────
REQUIRE_ACTIVE_SESSION=true           # Exiger une session active en mémoire
ALLOW_SESSION_RECOVERY=false          # Permettre la récupération auto (false en prod)
VALIDATE_SESSION_METADATA=true        # Valider IP/UserAgent (détection changement)

# ─────────────────────────────────────────────────────────────────────────────
# 🍪 COOKIES SÉCURISÉS
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development                  # development | production
COOKIE_SECURE=true                    # HTTPS uniquement en production
COOKIE_SAMESITE=strict                # strict | lax | none

# ─────────────────────────────────────────────────────────────────────────────
# 🔍 AUDIT ET MONITORING
# ─────────────────────────────────────────────────────────────────────────────
LOG_AUTH_ACCESS=false                 # Logger tous les accès authentifiés
DEBUG_MODE=false                      # Mode debug (ajoute des infos dans les réponses)

# ─────────────────────────────────────────────────────────────────────────────
# 🧪 MODE DÉVELOPPEMENT (DÉSACTIVER EN PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_DEV_API_KEY=false               # Permettre la clé API de dev (false en prod!)
DEV_API_KEY=dev-api-key-for-testing   # Clé API pour le développement
DEV_USER_ID=68f3c84e07195344872c74b6  # User ID de test

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️  BASE DE DONNÉES
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/qvarry
DATABASE_NAME=qvarry

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 SERVEUR
# ─────────────────────────────────────────────────────────────────────────────
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
CLIENT_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 CLOUDFLARE TURNSTILE (CAPTCHA ANTI-BOT)
# ─────────────────────────────────────────────────────────────────────────────
# Obtenez vos clés sur : https://dash.cloudflare.com/?to=/:account/turnstile
# ⚠️ IMPORTANT: Les deux clés sont nécessaires pour que Turnstile fonctionne !

# Clé publique (visible côté client - Next.js)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAACOHXH7S6G_Pfe5l

# Clé secrète (côté serveur uniquement)
TURNSTILE_SECRET_KEY=0x4AAAAAACOHXBwzk2hZspSqWCiiJvSz9bo

# ─────────────────────────────────────────────────────────────────────────────
# Clés de test Cloudflare (UNIQUEMENT pour localhost) :
# ─────────────────────────────────────────────────────────────────────────────
# VISIBLE (widget affiché) :
#   Site Key: 1x00000000000000000000AA = Toujours passe ✅
#   Site Key: 2x00000000000000000000AB = Toujours échoue ❌
# INVISIBLE :
#   Site Key: 1x00000000000000000000BB = Toujours passe ✅
# SECRET KEY (pour tous les tests) :
#   1x0000000000000000000000000000000AA = Toujours valide ✅

# Bypass le captcha en développement (false en production!)
BYPASS_CAPTCHA=false

# ─────────────────────────────────────────────────────────────────────────────
# 📧 CONFIGURATION SMTP (EMAILS)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@qvarry.com

# ─────────────────────────────────────────────────────────────────────────────
# 📝 NOTES IMPORTANTES
# ─────────────────────────────────────────────────────────────────────────────
# 1. Générer des secrets forts en production :
#    - JWT_SECRET: openssl rand -base64 64
#    - MASTER_KEY: openssl rand -hex 32
#
# 2. En production, définir :
#    - NODE_ENV=production
#    - ALLOW_DEV_API_KEY=false
#    - ALLOW_SESSION_RECOVERY=false
#    - VALIDATE_SESSION_METADATA=true
#
# 3. Adapter les durées selon vos besoins :
#    - JWT_EXPIRES_IN: 15m à 30m (courte durée)
#    - REFRESH_TOKEN_EXPIRES_IN: 72h à 168h (3-7 jours)
#
# 4. Rate limiting :
#    - 10 tentatives max en 15min = bon compromis sécurité/UX
#    - Ajuster selon votre cas d'usage
# ═══════════════════════════════════════════════════════════════════════════

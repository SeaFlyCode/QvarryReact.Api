e# ═══════════════════════════════════════════════════════════════════════════
 ?# QVARRY API - TEMPLATE DE CONFIGURATION (PRODUCTION)
# ═══════════════════════════════════════════════════════════════════════════
# Copiez ce fichier en .env et adaptez les valeurs selon votre environnement
#
# Pour générer des secrets sécurisés :
#   - Clé hex 64 chars : openssl rand -hex 32
#   - Secret base64    : openssl rand -base64 64
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 🌐 ENVIRONNEMENT GÉNÉRAL
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# URL du client frontend (CORS, liens emails)
CLIENT_URL=https://app.qvarry.fr
FRONTEND_URL=https://app.qvarry.fr

# ─────────────────────────────────────────────────────────────────────────────
# 🔐 SECRETS ET CLÉS DE CHIFFREMENT
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ IMPORTANT: Générez des valeurs uniques et sécurisées !

# Secret JWT pour la signature des tokens d'authentification
# Générer avec: openssl rand -base64 64
JWT_SECRET=CHANGEZ_MOI_OBLIGATOIRE

# Clé de chiffrement des données sensibles utilisateurs (fiches, points, etc.)
# Générer avec: openssl rand -hex 32 (doit faire exactement 64 caractères hex)
ENCRYPTION_KEY_MASTER=CHANGEZ_MOI_64_CARACTERES_HEX_OBLIGATOIRE

# Clé de chiffrement pour les communications (messages, conversations)
# Générer avec: openssl rand -hex 32 (doit faire exactement 64 caractères hex)
ENCRYPTION_KEY_COMMUNICATION=CHANGEZ_MOI_64_CARACTERES_HEX_OBLIGATOIRE

# Secret pour le hash des adresses IP dans les logs d'audit (anonymisation RGPD)
# Générer avec: openssl rand -hex 32
IP_HASH_SECRET=CHANGEZ_MOI_OBLIGATOIRE

# ─────────────────────────────────────────────────────────────────────────────
# 🔑 ROTATION DES CLÉS JWT (Optionnel - Avancé)
# ─────────────────────────────────────────────────────────────────────────────
# Permet de faire une rotation des clés JWT sans invalider les anciens tokens
# JWT_SECRET_V1=ancienne_cle_pour_tokens_existants
# JWT_SECRET_V2=nouvelle_cle_active

# ─────────────────────────────────────────────────────────────────────────────
# ⏱️ DURÉES DES TOKENS
# ─────────────────────────────────────────────────────────────────────────────
# JWT Access Token - Durée courte (recommandé: 15m-30m)
JWT_EXPIRES_IN=15m

# Refresh Token - Durée longue (en heures)
REFRESH_TOKEN_EXPIRES_IN=48

# ─────────────────────────────────────────────────────────────────────────────
# 🔒 SÉCURITÉ DES SESSIONS
# ─────────────────────────────────────────────────────────────────────────────
REQUIRE_ACTIVE_SESSION=true
ALLOW_SESSION_RECOVERY=false
VALIDATE_SESSION_METADATA=true
SESSION_TTL=3600
SESSION_TIMEOUT_MS=3600000
SESSION_CLEANUP_INTERVAL_MS=300000
MAX_SESSIONS_PER_USER=5
MAX_TOTAL_SESSIONS=10000

# ─────────────────────────────────────────────────────────────────────────────
# 🍪 COOKIES (Utilisé pour les tokens web)
# ─────────────────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# ─────────────────────────────────────────────────────────────────────────────
# 🛡️ RATE LIMITING - Protection contre le brute force
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_BLOCK_MINUTES=30

# Rate limiting pour routes mobiles
MOBILE_RATE_LIMIT_MAX=5
MOBILE_RATE_LIMIT_WINDOW_MINUTES=15
MOBILE_RATE_LIMIT_BLOCK_MINUTES=30

# ─────────────────────────────────────────────────────────────────────────────
# 🚨 ALERTES DE SÉCURITÉ AUTOMATIQUES
# ─────────────────────────────────────────────────────────────────────────────
SECURITY_AUTO_BLOCK_THRESHOLD=10
SECURITY_AUTO_BLOCK_HOURS=24
SECURITY_ANALYSIS_WINDOW=15

# ─────────────────────────────────────────────────────────────────────────────
# 🗄️ BASE DE DONNÉES MONGODB
# ─────────────────────────────────────────────────────────────────────────────
DB_CONN_STRING=mongodb+srv://user:password@cluster.mongodb.net/?appName=QvarryStorage
DB_NAME=QvarryStorage
DB_SSL=true

# ─────────────────────────────────────────────────────────────────────────────
# 🔴 REDIS - Sessions persistantes et blacklist tokens
# ─────────────────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis-server
REDIS_PORT=6379
REDIS_PASSWORD=VOTRE_MOT_DE_PASSE_REDIS
REDIS_DB=0
REDIS_TLS=false

# Configuration cluster Redis (optionnel)
USE_REDIS_CLUSTER=false
REDIS_CLUSTER_NODES=

# ─────────────────────────────────────────────────────────────────────────────
# 🤖 CLOUDFLARE TURNSTILE (CAPTCHA Anti-bot)
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=VOTRE_CLE_SECRETE_TURNSTILE
BYPASS_CAPTCHA=false

# ─────────────────────────────────────────────────────────────────────────────
# 📧 CONFIGURATION SMTP (Envoi d'emails)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@qvarry.fr
SMTP_PASS=VOTRE_MOT_DE_PASSE_SMTP
EMAIL_FROM=noreply@qvarry.fr
CONTACT_EMAIL=contact@qvarry.fr

# ─────────────────────────────────────────────────────────────────────────────
# 📱 CONFIGURATION MOBILE
# ─────────────────────────────────────────────────────────────────────────────
MIN_IOS_VERSION=1.0.0
MIN_ANDROID_VERSION=1.0.0
MOBILE_BUNDLE_ID_IOS=fr.qvarry.app
MOBILE_BUNDLE_ID_ANDROID=fr.qvarry.app

# ─────────────────────────────────────────────────────────────────────────────
# 🆘 MODE SOS - Vonage SMS (Alertes d'urgence)
# ─────────────────────────────────────────────────────────────────────────────
# Clé API Vonage (trouvable sur https://dashboard.nexmo.com/settings)
VONAGE_API_KEY=CHANGEZ_MOI
VONAGE_API_SECRET=CHANGEZ_MOI

# Nom ou numéro d'expéditeur SMS (max 11 caractères alphanumériques pour la France)
VONAGE_SMS_FROM=Qvarry

# ─────────────────────────────────────────────────────────────────────────────
# 🔍 AUDIT, LOGGING ET MONITORING
# ─────────────────────────────────────────────────────────────────────────────
DEBUG_MODE=false
LOG_AUTH_ACCESS=false
LOG_ADMIN_ACCESS=true
SEND_LOGIN_ALERTS=true
# ═══════════════════════════════════════════════════════════════════════════

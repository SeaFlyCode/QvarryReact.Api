# ════════════════════════════════════════════════════════
# 🚫 Qvarry - Git Ignore File
# ════════════════════════════════════════════════════════
# Monorepo structure: client/ (Next.js) + server/ (Express)
# ════════════════════════════════════════════════════════

# ════════════════════════════════════════════════════════
# 📦 Dependencies
# ════════════════════════════════════════════════════════
node_modules/
.pnp
.pnp.js
.pnp.*

# ════════════════════════════════════════════════════════
# 🎨 Next.js (Frontend Client)
# ════════════════════════════════════════════════════════
.next/
out/
build/
dist/

# Next.js cache
.next/cache/

# Next.js build output
client/.next/
client/out/
client/build/
client/dist/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ════════════════════════════════════════════════════════
# 🚀 Express (Backend Server)
# ════════════════════════════════════════════════════════
server/dist/
server/build/
server/*.tsbuildinfo

# ════════════════════════════════════════════════════════
# 🔐 Environment Variables & Configuration
# ════════════════════════════════════════════════════════
# Production environment files (injected by Dokploy/Docker)
.env
.env.docker
.env.production
.env.production.local
.env.test.local
.env.secrets

# Client environment files
client/.env
client/.env.local
client/.env.production
client/.env.production.local

# Server environment files
server/.env
server/.env.local
server/.env.production
server/.env.production.local

# ⚠️ Keep development environment files for local setup
!.env.development
!.env.example
!.env.dev
.env.prod
!client/.env.development
!client/.env.example
!server/.env.development
!server/.env.example


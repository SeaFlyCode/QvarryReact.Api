{
  "name": "qvarryreactbackend",
  "version": "1.0.6",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "npx tsc",
    "build:prod": "npm run build && npm run obfuscate",
    "prebuild": "echo Building TypeScript server...",
    "obfuscate": "node --stack-size=8192 scripts/obfuscate.js",
    "verify:obfuscation": "node scripts/verify-obfuscation.js",
    "verify:obfuscation:verbose": "node scripts/verify-obfuscation.js -v",
    "verify:obfuscation:full": "node scripts/verify-obfuscation.js -v -s",
    "type-check": "tsc --noEmit",
    "verify": "npm run type-check",
    "audit": "npx ts-node scripts/audit-infrastructure.ts",
    "audit:tokens": "npx ts-node scripts/audit-token-refresh.ts",
    "audit:stress": "npx ts-node scripts/audit-stress-test.ts",
    "audit:verbose": "VERBOSE=true npx ts-node scripts/audit-infrastructure.ts",
    "audit:all": "npm run audit && npm run audit:tokens && npm run audit:stress"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/ioredis": "^4.28.10",
    "@types/ws": "^8.18.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.15.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.14",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "axios": "^1.7.0",
    "javascript-obfuscator": "^4.1.1",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

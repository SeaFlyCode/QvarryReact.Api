{
  "name": "qvarryreactbackend",
  "version": "1.4.2",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "dev": "nodemon src/server.ts",
    "dev:debug": "DEBUG=* nodemon --inspect src/server.ts",
    "build": "npm run clean && tsc -p tsconfig.prod.json",
    "build:prod": "npm run build && npm run obfuscate",
    "build:watch": "tsc --watch",
    "prebuild": "echo '🔨 Building TypeScript server...'",
    "postbuild": "echo '✅ Build completed successfully!'",
    "clean": "rm -rf dist",
    "obfuscate": "node --stack-size=8192 scripts/obfuscate.js",
    "verify:obfuscation": "node scripts/verify-obfuscation.js",
    "verify:obfuscation:verbose": "node scripts/verify-obfuscation.js -v",
    "verify:obfuscation:full": "node scripts/verify-obfuscation.js -v -s",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "verify": "npm run type-check",
    "lint": "eslint src/**/*.ts --fix",
    "lint:check": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:clustering": "jest redisPubSubService.test.ts && jest webSocketService.clustering.test.ts",
    "test:clustering:unit": "jest redisPubSubService.test.ts",
    "test:clustering:integration": "jest webSocketService.clustering.test.ts",
    "test:clustering:e2e": "ts-node scripts/e2e-test-clustering.ts",
    "test:clustering:chaos": "jest clusteringChaos.test.ts",
    "test:clustering:all": "npm run test:clustering && npm run test:clustering:e2e",
    "test:load:clustering": "cd tests/load && artillery run artillery-clustering.yml || echo 'Artillery clustering config not yet created'",
    "test:resilience:all": "npm run test:resilience:unit && npm run test:resilience:integration && npm run test:resilience:chaos",
    "test:resilience:unit": "jest webSocketStateService.test.ts",
    "test:resilience:integration": "jest webSocketService.resilience.test.ts",
    "test:resilience:chaos": "jest webSocketResilience.test.ts",
    "test:resilience:e2e": "ts-node scripts/e2e-test-resilience.ts",
    "test:resilience:performance": "jest statePerformance.test.ts",
    "test:resilience:watch": "jest --watch --testPathPattern=resilience",
    "test:resilience:coverage": "jest --coverage --testPathPattern=resilience",
    "test:resilience:ci": "jest --ci --testPathPattern=resilience --maxWorkers=2",
    "test:load:resilience": "cd tests/load && artillery run artillery-resilience.yml || echo 'Artillery resilience config not yet created'",
    "audit": "npx ts-node scripts/audit-infrastructure.ts",
    "audit:tokens": "npx ts-node scripts/audit-token-refresh.ts",
    "audit:stress": "npx ts-node scripts/audit-stress-test.ts",
    "audit:verbose": "VERBOSE=true npx ts-node scripts/audit-infrastructure.ts",
    "audit:all": "npm run audit && npm run audit:tokens && npm run audit:stress",
    "audit:deps": "npm audit --production",
    "audit:deps:fix": "npm audit fix --production",
    "test:load": "artillery run artillery-websocket.yml",
    "test:load:stress": "artillery run artillery-websocket.yml --environment stress",
    "test:load:custom": "ts-node scripts/load-test-websocket.ts",
    "test:load:report": "artillery run artillery-websocket.yml --output load-test-report.json && artillery report load-test-report.json",
    "db:backup": "echo 'Backup script not configured'",
    "docker:build": "docker build --platform linux/amd64 -t docker.matheovieilleville.fr/qvarry-api:latest -t docker.matheovieilleville.fr/qvarry-api:$(node -p \"require('./package.json').version\") .",
    "docker:build:no-cache": "docker build --platform linux/amd64 --no-cache -t docker.matheovieilleville.fr/qvarry-api:latest .",
    "docker:push": "docker push docker.matheovieilleville.fr/qvarry-api:latest && docker push docker.matheovieilleville.fr/qvarry-api:$(node -p \"require('./package.json').version\")",
    "docker:release": "npm run docker:build && npm run docker:push",
    "docker:run": "docker run -d -p 3000:3000 --env-file .env --name qvarry-api docker.matheovieilleville.fr/qvarry-api:latest",
    "docker:stop": "docker stop qvarry-api && docker rm qvarry-api",
    "docker:logs": "docker logs -f qvarry-api",
    "precommit": "npm run type-check && npm run lint:check",
    "prepare": "npm run build",
    "health": "curl -s http://localhost:${PORT:-3000}/health || echo 'Server not running'",
    "ws:state:list": "ts-node scripts/recover-websocket-states.ts list",
    "ws:state:inspect": "ts-node scripts/recover-websocket-states.ts inspect",
    "ws:state:clear": "ts-node scripts/recover-websocket-states.ts clear",
    "ws:state:export": "ts-node scripts/recover-websocket-states.ts export",
    "ws:state:count": "ts-node scripts/recover-websocket-states.ts count",
    "ws:state:help": "ts-node scripts/recover-websocket-states.ts help",
    "test:push": "ts-node scripts/test-push-notification.ts",
    "test:push:check": "ts-node scripts/test-push-notification.ts check",
    "test:push:list": "ts-node scripts/test-push-notification.ts list"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.15.0",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "otpauth": "^9.5.0",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.14",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "artillery": "^2.0.30",
    "axios": "^1.7.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^9.1.0",
    "javascript-obfuscator": "^4.1.1",
    "jest": "^29.0.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

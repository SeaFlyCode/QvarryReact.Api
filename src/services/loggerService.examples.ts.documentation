// ════════════════════════════════════════════════════════
// 👶 4. Child Logger - Logger avec contexte
// ════════════════════════════════════════════════════════

// Créer un child logger pour un service spécifique
const authLogger = logger.child({ service: "auth" });

// Tous les logs avec authLogger incluront { service: 'auth' }
authLogger.info("Utilisateur authentifié", { userId: "123" });
// Résultat: { service: 'auth', userId: '123', message: 'Utilisateur authentifié', ... }

authLogger.error("Échec de l'authentification", {
  userId: "123",
  reason: "Token expiré",
});
// Résultat: { service: 'auth', userId: '123', reason: 'Token expiré', ... }

// Child logger dans un contrôleur
const userLogger = logger.child({ controller: "UserController" });
userLogger.info("Création d'utilisateur", { email: "user@example.com" });


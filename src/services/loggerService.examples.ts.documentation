// Avec le middleware de corrélation actif, tous les logs
// incluront automatiquement le correlation ID de la requête

app.get("/api/example", async (req, res) => {
  // Ce log inclura automatiquement req.correlationId
  logger.info("Traitement de la requête", {
    endpoint: "/api/example",
  });

  // Même dans des fonctions asynchrones profondes
  await someAsyncFunction();

  // Le correlation ID sera toujours présent
  logger.info("Requête terminée");

  res.json({ success: true });
});

async function someAsyncFunction() {
  // Même ici, le correlation ID est disponible via AsyncLocalStorage
  logger.debug("Fonction async appelée");
}

// ════════════════════════════════════════════════════════
// 🎯 7. Utilisation dans un middleware Express
// ════════════════════════════════════════════════════════

import { Request, Response, NextFunction } from "express";

function authMiddleware(req: Request, res: Response, next: NextFunction) {
  const authLogger = logger.child({ middleware: "auth" });

  const token = req.headers.authorization;

  if (!token) {
    authLogger.warn("Requête sans token", {
      path: req.path,
      ip: req.ip,
    });
    return res.status(401).json({ error: "Unauthorized" });
  }

  try {
    // Vérifier le token...
    authLogger.info("Token validé", { userId: "extracted-user-id" });
    next();
  } catch (error) {
    authLogger.error("Erreur de validation du token", {
      error: error.message,
    });
    res.status(401).json({ error: "Invalid token" });
  }
}

// ════════════════════════════════════════════════════════
// 🐛 8. Logging d'erreurs avec stack trace
// ════════════════════════════════════════════════════════

try {
  // Code qui peut échouer
  throw new Error("Une erreur est survenue");
} catch (error) {
  logger.error("Erreur attrapée", {
    error: error.message,
    stack: error.stack,
    context: "additional-context",
  });
}

// ════════════════════════════════════════════════════════
// 🌐 9. Utilisation dans différents services
// ════════════════════════════════════════════════════════

// Service de base de données
const dbLogger = logger.child({ service: "database" });

async function connectToDatabase() {
  dbLogger.info("Tentative de connexion à MongoDB");
  try {
    // Connexion...
    dbLogger.info("Connexion réussie", {
      host: "localhost",
      port: 27017,
    });
  } catch (error) {
    dbLogger.error("Échec de connexion", {
      error: error.message,
    });
    throw error;
  }
}

// Service Redis
const redisLogger = logger.child({ service: "redis" });

async function cacheData(key: string, value: any) {
  redisLogger.debug("Mise en cache des données", { key });
  try {
    // Mise en cache...
    redisLogger.info("Données mises en cache", {
      key,
      ttl: 3600,
    });
  } catch (error) {
    redisLogger.error("Erreur de mise en cache", {
      key,
      error: error.message,
    });
  }
}

// Service WebSocket
const wsLogger = logger.child({ service: "websocket" });

function onWebSocketConnection(socket: any) {
  wsLogger.info("Nouvelle connexion WebSocket", {
    socketId: socket.id,
  });

  socket.on("disconnect", () => {
    wsLogger.info("Déconnexion WebSocket", {
      socketId: socket.id,
    });
  });
}

// ════════════════════════════════════════════════════════
// 📊 10. Monitoring et métriques
// ════════════════════════════════════════════════════════

// Logger les performances
function logPerformance(operation: string, duration: number) {
  logger.info("Métrique de performance", {
    operation,
    duration,
    unit: "ms",
    type: "performance",
  });
}

// Exemple avec mesure de temps
async function performExpensiveOperation() {
  const start = Date.now();

  logger.debug("Début de l'opération coûteuse");

  // Opération...
  await new Promise((resolve) => setTimeout(resolve, 1000));

  const duration = Date.now() - start;
  logPerformance("expensive-operation", duration);

  logger.debug("Fin de l'opération coûteuse", { duration });
}

// ════════════════════════════════════════════════════════
// 🚨 11. Gestion des erreurs non gérées
// ════════════════════════════════════════════════════════

process.on("uncaughtException", (error: Error) => {
  logger.critical("Exception non capturée", {
    error: error.message,
    stack: error.stack,
    type: "uncaughtException",
  });

  // Laisser le temps au logger d'écrire avant de quitter
  setTimeout(() => process.exit(1), 1000);
});

process.on("unhandledRejection", (reason: any) => {
  logger.critical("Promise rejection non gérée", {
    reason: reason?.message || reason,
    stack: reason?.stack,
    type: "unhandledRejection",
  });
});


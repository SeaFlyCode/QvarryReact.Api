// Log debug (uniquement en développement par défaut)
logger.debug("Détails de debug", { userId: "123", action: "test" });

// Log info (niveau par défaut en production)
logger.info("Serveur démarré avec succès", {
  port: 3000,
  env: process.env.NODE_ENV,
});

// Log HTTP (pour les requêtes HTTP)
logger.http("GET /api/users - 200 OK", {
  method: "GET",
  path: "/api/users",
  status: 200,
  responseTime: 45,
});

// Log warning
logger.warn("Tentative de connexion échouée", {
  userId: "123",
  reason: "Mot de passe incorrect",
  attempts: 3,
});

// Log error
logger.error("Erreur de connexion à MongoDB", {
  error: "Connection timeout",
  host: "localhost:27017",
});

// Log critical (niveau le plus élevé)
logger.critical("Exception non gérée détectée", {
  error: "TypeError: Cannot read property x of undefined",
  stack: "Stack trace...",
  service: "auth",
});


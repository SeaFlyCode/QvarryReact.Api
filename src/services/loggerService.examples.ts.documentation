import { logger } from "./services/loggerService";
import { correlationMiddleware } from "./middlewares/correlationMiddleware";
import express from "express";

// ════════════════════════════════════════════════════════
// 🚀 1. Configuration du middleware dans Express
// ════════════════════════════════════════════════════════

const app = express();

// IMPORTANT: Ajouter le middleware de corrélation AVANT les autres middlewares
// pour que tous les logs incluent le correlation ID
app.use(correlationMiddleware);

